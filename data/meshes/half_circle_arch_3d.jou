# 3D shallow arch generated by sweeping a thin rectangular section through a
# reduced angle about the z-axis. The sweep is centered about the crown so the
# arch apex still lands at +y.
#
# Usage:
#   cubit -batch half_circle_arch_3d.jou
#
# The wall thickness is tied to the arch radius and is currently set to be
# half of the previous thin shallow-arch case. The out-of-plane width stays
# fixed independently so the wider z-span is preserved, with 3 elements
# through the wall thickness. Two cut faces are tagged for support
# constraints, and a crown patch near the top of the arch is tagged for
# loading / displacement BCs.

reset
undo off
compress ids all

#{outer_radius        = 1.0}
#{wall_thickness      = outer_radius / 80.0}
#{inner_radius        = outer_radius - wall_thickness}
#{width               = 0.30 * outer_radius}
#{n_through_thickness = 3}
#{n_across_width      = 6}
#{n_along_arch        = 36}
#{sweep_angle         = 60.0}
#{start_angle         = 0.5 * (180.0 - sweep_angle)}
#{support_mid_radius  = 0.5 * (inner_radius + outer_radius)}
#{support_x           = 0.5 * support_mid_radius}
#{support_y           = 0.8660254037844386 * support_mid_radius}
#{support_eps         = 0.05 * wall_thickness}
#{crown_band          = 0.10 * outer_radius}
#{outfile             = "half_circle_arch_3d.g"}

# Build the source section in the x-z plane; it will be rotated and then
# revolved into a shallow arch lying in the x-y plane.
create vertex {inner_radius} 0.0 {-0.5 * width}
create vertex {outer_radius} 0.0 {-0.5 * width}
create vertex {outer_radius} 0.0 { 0.5 * width}
create vertex {inner_radius} 0.0 { 0.5 * width}

create curve vertex 1 2
create curve vertex 2 3
create curve vertex 3 4
create curve vertex 4 1
create surface curve 1 2 3 4

surface 1 scheme map
curve 1 3 interval {n_through_thickness}
curve 2 4 interval {n_across_width}
mesh surface 1

# Center the sweep about the crown at +y, then revolve a reduced angle to make
# the arch shallower than a half-circle.
rotate surface 1 angle {start_angle} about z
sweep surface 1 angle {sweep_angle} about z segment {n_along_arch} merge
compress ids all

volume 1 scheme sweep source surface 1 target surface 6
mesh volume 1

block 1 add volume all
block 1 name "arch"

# The two cut faces at the arch feet are support regions.
sideset 1 add face in volume all with x_coord < {-support_x + support_eps} and y_coord > {support_y - support_eps} and y_coord < {support_y + support_eps}
sideset 1 name "left_support"

sideset 2 add face in volume all with x_coord > {support_x - support_eps} and y_coord > {support_y - support_eps} and y_coord < {support_y + support_eps}
sideset 2 name "right_support"

# A crown patch near the top of the arch for loading / displacement control.
sideset 3 add face in volume all with y_coord > {outer_radius - crown_band}
sideset 3 name "crown_top"

export genesis "{outfile}" overwrite
