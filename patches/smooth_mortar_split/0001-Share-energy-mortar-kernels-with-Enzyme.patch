+inline PenaltyRamp penalty_ramp( double g, double del, PenaltySmoothing type )
+{
+  if ( type == PenaltySmoothing::Hard ) {
+    return g < 0.0 ? PenaltyRamp{ g, 1.0, 0.0 } : PenaltyRamp{ 0.0, 0.0, 0.0 };
