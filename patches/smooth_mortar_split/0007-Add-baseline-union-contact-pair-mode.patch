From: Michael Tupek <mrtupek@gmail.com>
Date: Tue, 26 May 2026 21:07:28 -0600
Subject: [PATCH 7/7] Add baseline union contact pair mode

---
 src/tribol/interface/mfem_tribol.cpp | 20 ++++++++++++++++
 src/tribol/interface/mfem_tribol.hpp | 21 ++++++++++++++++
 src/tribol/mesh/CouplingScheme.cpp   | 36 +++++++++++++++++++++++++++-
 src/tribol/mesh/CouplingScheme.hpp   | 22 +++++++++++++++++
 4 files changed, 98 insertions(+), 1 deletion(-)

diff --git a/src/tribol/interface/mfem_tribol.cpp b/src/tribol/interface/mfem_tribol.cpp
index 4aea730..8670eee 100644
--- a/src/tribol/interface/mfem_tribol.cpp
+++ b/src/tribol/interface/mfem_tribol.cpp
@@ -403,6 +403,26 @@ void setMfemEnergyMortarOptions( IndexT cs_id, SmoothingType smoothing_type,
   cs->getMfemMeshData()->SetEnergyMortarOptions( opts );
 }
 
+void setMfemUseBaselineUnion( IndexT cs_id, bool use_baseline )
+{
+  auto cs = CouplingSchemeManager::getInstance().findData( cs_id );
+  SLIC_ERROR_ROOT_IF(
+      !cs, axom::fmt::format( "Coupling scheme cs_id={0} does not exist. Call tribol::registerMfemCouplingScheme() "
+                              "to create a coupling scheme with this cs_id.",
+                              cs_id ) );
+  cs->setUseBaselineUnion( use_baseline );
+}
+
+void snapshotMfemBaselinePairs()
+{
+  for ( auto& cs_pair : CouplingSchemeManager::getInstance() ) {
+    auto& cs = cs_pair.second;
+    if ( cs.useBaselineUnion() ) {
+      cs.resetBaselineForLoadStep();
+    }
+  }
+}
+
 void setMfemViscousDampingCoeff( IndexT cs_id, RealT mesh1_coeff, RealT mesh2_coeff )
 {
   auto cs = CouplingSchemeManager::getInstance().findData( cs_id );
diff --git a/src/tribol/interface/mfem_tribol.hpp b/src/tribol/interface/mfem_tribol.hpp
index 5a80b72..e56a8ab 100644
--- a/src/tribol/interface/mfem_tribol.hpp
+++ b/src/tribol/interface/mfem_tribol.hpp
@@ -114,6 +114,27 @@ void setMfemKinematicConstantPenalty( IndexT cs_id, RealT mesh1_penalty, RealT m
 void setMfemEnergyMortarOptions( IndexT cs_id, SmoothingType smoothing_type,
                                   PenaltySmoothing penalty_smoothing, double penalty_smoothing_del );
 
+/**
+ * @brief Enable baseline ∪ current pair set strategy for a coupling scheme
+ *
+ * When enabled, each Newton iteration uses baseline ∪ current pairs,
+ * preventing loss of contact interactions during the load step.
+ *
+ * @param cs_id The ID of the coupling scheme
+ * @param use_baseline Whether to enable the baseline union strategy
+ */
+void setMfemUseBaselineUnion( IndexT cs_id, bool use_baseline );
+
+/**
+ * @brief Reset baseline pairs for the upcoming load step
+ *
+ * Call once per load step before Newton iterations begin.  The baseline
+ * is captured automatically on the first apply() call of the load step
+ * (after performBinning() fills the current pairs).
+ * On load-step bisection/retry, call again to re-seed.
+ */
+void snapshotMfemBaselinePairs();
+
 /**
  * @brief Clears existing penalty data and sets kinematic element penalty
  *
diff --git a/src/tribol/mesh/CouplingScheme.cpp b/src/tribol/mesh/CouplingScheme.cpp
index 0d56444..47983df 100644
--- a/src/tribol/mesh/CouplingScheme.cpp
+++ b/src/tribol/mesh/CouplingScheme.cpp
@@ -7,6 +7,7 @@
 
 // C++ includes
 #include <cmath>
+#include <unordered_set>
 
 // MFEM includes
 #include "mfem.hpp"
@@ -1025,11 +1026,44 @@ void CouplingScheme::performBinning()
   return;
 }
 
+//------------------------------------------------------------------------------
+void CouplingScheme::resetBaselineForLoadStep()
+{
+  m_baseline_pairs = ArrayT<InterfacePair>( 0, 0, m_allocator_id );
+  m_baseline_needs_snapshot = true;
+}
+
 //------------------------------------------------------------------------------
 int CouplingScheme::apply( int cycle, RealT t, RealT& dt )
 {
   if ( m_formulation_impl ) {
-    if ( m_interface_pairs.size() > 0 ) {
+    if ( m_use_baseline_union && m_baseline_needs_snapshot && m_interface_pairs.size() > 0 ) {
+      m_baseline_pairs = ArrayT<InterfacePair>( m_interface_pairs );
+      m_baseline_needs_snapshot = false;
+    }
+    if ( m_use_baseline_union ) {
+      // Baseline ∪ current: baseline is immutable within a load step,
+      // current is the fresh search result each iteration.
+      std::unordered_set<uint64_t> seen;
+      ArrayT<InterfacePair> merged( 0, 0, m_allocator_id );
+      merged.reserve( m_baseline_pairs.size() + m_interface_pairs.size() );
+      for ( IndexT i = 0; i < m_baseline_pairs.size(); ++i ) {
+        auto& p = m_baseline_pairs[i];
+        uint64_t key = (static_cast<uint64_t>(p.m_element_id1) << 32) |
+                       static_cast<uint64_t>(p.m_element_id2);
+        seen.insert( key );
+        merged.emplace_back( p.m_element_id1, p.m_element_id2, p.m_is_contact_candidate );
+      }
+      for ( IndexT i = 0; i < m_interface_pairs.size(); ++i ) {
+        auto& p = m_interface_pairs[i];
+        uint64_t key = (static_cast<uint64_t>(p.m_element_id1) << 32) |
+                       static_cast<uint64_t>(p.m_element_id2);
+        if ( seen.find( key ) == seen.end() ) {
+          merged.emplace_back( p.m_element_id1, p.m_element_id2, p.m_is_contact_candidate );
+        }
+      }
+      m_formulation_impl->setInterfacePairs( std::move( merged ), 0 );
+    } else if ( m_interface_pairs.size() > 0 ) {
       m_formulation_impl->setInterfacePairs( std::move( m_interface_pairs ), 0 );
     }
     m_formulation_impl->updateNodalGaps();
diff --git a/src/tribol/mesh/CouplingScheme.hpp b/src/tribol/mesh/CouplingScheme.hpp
index b3ba4ec..ad998a4 100644
--- a/src/tribol/mesh/CouplingScheme.hpp
+++ b/src/tribol/mesh/CouplingScheme.hpp
@@ -504,6 +504,25 @@ class CouplingScheme {
   /// @overload
   const ArrayT<InterfacePair>& getInterfacePairs() const { return m_interface_pairs; }
 
+  /**
+   * @brief Enable baseline ∪ current pair set strategy
+   *
+   * When enabled, apply() merges the baseline snapshot with the current
+   * search results, preventing loss of contact pairs during Newton iterations.
+   */
+  void setUseBaselineUnion( bool use ) { m_use_baseline_union = use; }
+
+  /// @brief Query whether baseline union mode is active
+  bool useBaselineUnion() const { return m_use_baseline_union; }
+
+  /**
+   * @brief Clear the monotonic pair set for a new load step
+   *
+   * Call once at the beginning of each load step. Pairs will then
+   * accumulate monotonically via apply() until the next reset.
+   */
+  void resetBaselineForLoadStep();
+
   /**
    * @brief Get the number of active pairs on the coupling scheme
    *
@@ -953,6 +972,9 @@ class CouplingScheme {
   std::unique_ptr<ContactFormulation> m_formulation_impl;  ///< Polymorphic contact formulation implementation
 
   ArrayT<InterfacePair> m_interface_pairs;  ///< List of interface pairs
+  ArrayT<InterfacePair> m_baseline_pairs;       ///< Baseline pairs snapshot from load-step begin
+  bool m_use_baseline_union = false;            ///< When true, apply() passes baseline ∪ current to adapter
+  bool m_baseline_needs_snapshot = true;        ///< When true, next apply() captures baseline from current pairs
 
   CompGeom m_cg_pairs;  ///< Computational geometry container object
 
